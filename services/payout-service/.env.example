# Server Configuration
NODE_ENV=development
PORT=3028

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/hrm_payout

# RabbitMQ Connection
RABBITMQ_URL=amqp://localhost:5672

# Service URLs
PAYROLL_SERVICE_URL=http://localhost:3006
EMPLOYEE_SERVICE_URL=http://localhost:3003
NOTIFICATION_SERVICE_URL=http://localhost:3007

# Encryption Key for storing Razorpay credentials (32 bytes / 64 hex chars recommended)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYOUT_ENCRYPTION_KEY=

# Note: Razorpay credentials are stored per-tenant in the database
# Each tenant configures their own Razorpay X account credentials
