mobile-app/android/app/build/
mobile-app/android/build/
mobile-app/android/local.properties
mobile-app/ios/Pods/
mobile-app/ios/build/
mobile-app/.expo/
*.keystore
*.jks

# Misc
*.pid
*.seed
*.pid.lock
.eslintcache
.stylelintcache

# Output files from terraform
outputs.json
infrastructure/outputs.json

# Azure credentials (never commit!)
azure.json
*.azureauth

